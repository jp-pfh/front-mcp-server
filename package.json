{
  "name": "front-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Front API integration - read-only access to conversations, contacts, and messages",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "front-mcp-server": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
